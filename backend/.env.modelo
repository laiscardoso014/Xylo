# =====================================================================
# .env  ->  SÓ PARA RODAR NO SEU COMPUTADOR (npm run dev)
#
# Como usar: copie este arquivo, renomeie a cópia para ".env" (com o ponto,
# sem ".modelo") e troque o que está em MAIÚSCULAS.
# Se você já tem um .env funcionando, NÃO substitua: só confira as linhas.
#
# O .env NUNCA vai para o GitHub (o .gitignore impede).
# Na web (Render) estes valores são colocados em Environment, não aqui:
# veja o arquivo RENDER-VARIAVEIS.txt na pasta principal.
# =====================================================================

# Banco do seu computador (PostgreSQL instalado no Windows)
CONNECTION_STRING=postgresql://postgres:SENHA_DO_SEU_POSTGRES@localhost:5432/db_woodcontrol

# Texto longo e aleatório (qualquer um, só não deixe curto)
JWT_SECRET=TROQUE-POR-UM-TEXTO-LONGO-E-ALEATORIO-xylo-2026

PORT=3000

# Endereço das páginas no computador (Live Server: 5500; ou o próprio servidor: 3000)
APP_URL=http://localhost:3000

# --- E-mail (opcional) ---------------------------------------------
# Sem estas linhas: os links de ativação aparecem na tela (bom para testar).
# Com a Brevo (grátis):
# EMAIL_BREVO_CHAVE=xkeysib-SUA_CHAVE
# EMAIL_REMETENTE=Xylo <SEU_EMAIL_CONFIRMADO@gmail.com>

# --- IA do assistente e da leitura de ticket (grátis) ---------------
ASSISTENTE_PROVEDOR=groq
ASSISTENTE_CHAVE=SUA_CHAVE_DO_GROQ
ASSISTENTE_RESERVA=gemini
ASSISTENTE_RESERVA_CHAVE=SUA_CHAVE_DO_GEMINI
