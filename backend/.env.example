# Copie este arquivo para ".env" e preencha. NUNCA envie o .env para o GitHub.

# Banco de dados PostgreSQL
CONNECTION_STRING=postgresql://postgres:SUA_SENHA@localhost:5432/db_woodcontrol

# Chave para assinar os tokens de login (use um texto longo e aleatório)
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio

PORT=3000

# Endereço do site que pode chamar a API (em produção). Vazio = qualquer um.
# FRONTEND_URL=https://seu-dominio.com.br

# --- Assistente virtual (IA) ------------------------------------------
# Sem IA configurada, o assistente funciona no "modo básico" (palavras-chave).
#
# Opções GRATUITAS:
#   groq   -> chave grátis (sem cartão) em https://console.groq.com/keys      (recomendado)
#   gemini -> chave grátis (sem cartão) em https://aistudio.google.com/apikey
#             (no plano grátis o Google pode usar as perguntas para melhorar os produtos)
#   ollama -> roda no próprio computador, sem chave e sem internet (https://ollama.com)
#             depois de instalar: ollama pull qwen2.5:7b
# Opção paga:
#   anthropic -> Claude, chave em https://console.anthropic.com
ASSISTENTE_PROVEDOR=groq
ASSISTENTE_CHAVE=

# Reserva (opcional): usada automaticamente se a principal falhar ou o limite
# grátis acabar. Só se as duas falharem o assistente volta ao modo básico.
ASSISTENTE_RESERVA=gemini
ASSISTENTE_RESERVA_CHAVE=

# Opcional: trocar o modelo (o padrão de cada provedor já funciona)
# (para a reserva: ASSISTENTE_RESERVA_MODELO)
#   groq: openai/gpt-oss-120b | gemini: gemini-3.8-flash | ollama: qwen2.5:7b | anthropic: claude-haiku-5-5
#   Se o modelo for desativado pelo provedor, o sistema tenta sozinho os outros
#   modelos conhecidos daquele provedor. Deixe vazio para usar o padrão.
#   (O llama-3.3-70b-versatile da Groq foi desligado em 16/08/2026.)
# ASSISTENTE_MODELO=

# LER TICKET (foto do ticket de pesagem -> Nova viagem preenchida)
# Usa a MESMA chave do assistente, mas um modelo que enxerga imagens.
# Padrões: groq = qwen/qwen3.8-27b · gemini = gemini-3.8-flash · ollama = qwen2.5vl:7b
# Só preencha se quiser trocar (ex.: o Groq mudou o nome do modelo de visão).
# ASSISTENTE_VISAO_MODELO=
# ASSISTENTE_RESERVA_VISAO_MODELO=
# Sem IA configurada, a tela "Ler ticket" aceita só o texto colado do ticket.
